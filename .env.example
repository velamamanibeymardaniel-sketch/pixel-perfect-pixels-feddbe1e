# Copie este archivo a .env y complete con los valores de su proyecto Supabase
# (Supabase > Project Settings > API).

# ── Cliente (navegador): solo claves públicas ─────────────────────────────
VITE_SUPABASE_URL=https://<su-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<clave-publishable-o-anon>
VITE_SUPABASE_PROJECT_ID=<id-del-proyecto>

# ── Servidor (funciones de servidor SSR) ──────────────────────────────────
SUPABASE_URL=https://<su-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clave-publishable-o-anon>

# SOLO SERVIDOR. Necesaria para crear/editar usuarios desde el panel de administración.
# NUNCA use el prefijo VITE_, nunca la exponga en el frontend ni la suba al repositorio.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Opcional: solo para herramientas locales de migración (drizzle-kit).
# DATABASE_URL=postgresql://postgres:<password>@db.<su-proyecto>.supabase.co:5432/postgres
